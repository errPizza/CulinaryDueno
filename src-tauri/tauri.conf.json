{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Culinary Dueño",
  "mainBinaryName": "culinary-dueno",
  "version": "0.1.1",
  "identifier": "mx.culinaryrestaurant.owner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5190",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Culinary Dueño", "width": 1280, "height": 800, "minWidth": 360, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'"
    }
  },
  "bundle": { "active": true, "publisher": "Culinary", "copyright": "© 2026 Culinary", "shortDescription": "Culinary Dueño, por PizzaDev", "targets": ["nsis"], "icon": ["icons/icon.ico"] }
}
